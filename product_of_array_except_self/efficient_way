class Solution:
    def productExceptSelf(self, nums: list[int]) -> list[int]:
        mylist = [1] * len(nums)
        prefix = 1
        for i in range(len(nums)):
            mylist[i] = prefix
            prefix = prefix * nums[i]
        suffix = 1
        for j in range(len(nums)-1,-1,-1):
            mylist[j] = mylist[j] * suffix
            suffix = suffix * nums[j]
        return mylist
